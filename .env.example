# HOSxP / Data Warehouse connection
DB_HOST=192.168.1.253
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
# Optional separate HOSxP source host; leaves the data warehouse on DB_HOST.
HOS_DB_HOST=192.168.1.253
# Optional dedicated HOSxP account (prefer SELECT-only while integration is read-only).
# HOS_DB_USER=your_hos_readonly_user
# HOS_DB_PASSWORD=your_hos_readonly_password
HOS_DB=hos
DW_DB=dw_hd-check

# API server
API_PORT=3001
# Set only when running behind a reverse proxy (IIS/nginx), e.g. 1 or loopback, so login
# rate limiting sees each client's real IP instead of the proxy's.
# TRUST_PROXY=1
# Set true only after verifying that HOS_DB_HOST and DB_HOST are the intended production pair.
SYNC_ENABLED=true
# Auto-sync current month from HOSxP every N minutes (0 = disabled)
AUTO_SYNC_MINUTES=15

# Near real-time: one light change check against HOSxP every N seconds (min 5), only while someone
# has the app open — or always on the sync instance (SYNC_ENABLED + AUTO_SYNC_MINUTES > 0).
REALTIME_POLL_SECONDS=10
# Sync instance only: when new herbal dispensing appears, re-sync yesterday..today at most once per N seconds (min 30).
# Run this on ONE instance only; other instances should keep AUTO_SYNC_MINUTES=0.
REALTIME_SYNC_MIN_SECONDS=60
