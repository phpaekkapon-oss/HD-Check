{
  "name": "hd-check",
  "private": true,
  "version": "1.1.12",
  "description": "HerbDx (SMART-HOSCHECK) - Monorepo for Frontend & Backend",
  "scripts": {
    "dev": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "start:backend": "npm run start --prefix backend",
    "sync": "npm run sync --prefix backend",
    "init-db": "npm run init-db --prefix backend",
    "build": "npm run build --prefix frontend",
    "release": "node scripts/release.mjs",
    "install:all": "npm install --prefix backend && npm install --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
